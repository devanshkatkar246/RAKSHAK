# ─────────────────────────────────────────────────────────────────────────────
# RAKSHAK Backend – Environment Variables
# Copy this to .env and fill in real values before running.
# ─────────────────────────────────────────────────────────────────────────────

# ── Application ───────────────────────────────────────────────────────────────
APP_NAME="RAKSHAK Backend"
APP_VERSION="1.0.0"
ENVIRONMENT="development"            # development | staging | production
DEBUG=true
API_V1_STR="/api/v1"

# ── Security / JWT ────────────────────────────────────────────────────────────
SECRET_KEY="CHANGE_ME_use_openssl_rand_hex_64"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30
ENCRYPTION_KEY="CHANGE_ME_32_char_fernet_key_here"  # Fernet key for PII fields

# ── Database (PostgreSQL + pgvector) ─────────────────────────────────────────
POSTGRES_HOST="localhost"
POSTGRES_PORT=5432
POSTGRES_DB="rakshak_db"
POSTGRES_USER="rakshak_user"
POSTGRES_PASSWORD="rakshak_secret"
DATABASE_URL="postgresql+asyncpg://rakshak_user:rakshak_secret@localhost:5432/rakshak_db"

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL="redis://localhost:6379/0"
REDIS_TTL_SECONDS=3600

# ── Google Gemini ─────────────────────────────────────────────────────────────
GEMINI_API_KEY="YOUR_GOOGLE_AI_API_KEY"
GEMINI_MODEL="gemini-2.5-flash"
GEMINI_TEMPERATURE=0.3
GEMINI_MAX_OUTPUT_TOKENS=8192

# ── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_BURST=10

# ── CORS ──────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:5173,https://app.rakshak.ai"

# ── Twilio (SMS / Voice SOS Calls) ───────────────────────────────────────────
TWILIO_ACCOUNT_SID="YOUR_TWILIO_SID"
TWILIO_AUTH_TOKEN="YOUR_TWILIO_TOKEN"
TWILIO_FROM_NUMBER="+15551234567"

# ── Firebase (Push Notifications) ────────────────────────────────────────────
FIREBASE_CREDENTIALS_PATH="./firebase_service_account.json"

# ── RAG Vector Store ──────────────────────────────────────────────────────────
VECTOR_STORE_COLLECTION="rakshak_medical_kb"
RAG_TOP_K=5
RAG_SIMILARITY_THRESHOLD=0.72

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL="INFO"
LOG_JSON_FORMAT=true
